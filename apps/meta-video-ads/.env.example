# Always stored in a dedicated demo subdirectory. Use an absolute persistent path on a server.
DATA_DIR=./data
MAX_VIDEO_MB=60
MAX_VIDEO_SECONDS=180
PORT=3000
# Use true behind HTTPS; local HTTP development defaults to false.
SECURE_COOKIE=false
# Optional, opt-in real analysis only. Publishing and reporting ALWAYS remain demo.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Optional future Meta read-only CLI, never loaded or used by the demo web app.
# META_AD_ACCOUNT_ID=
# META_GRAPH_VERSION=v27.0
# Inject META_VAULT_KEY and META_ACCESS_TOKEN from a secret manager, not this file.
